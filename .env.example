# Field Triage — Environment Configuration Template
# Operational data mode for backend profile loading: "demo" or "processed"
# Note: DATA_MODE=processed maps to public contract data_mode="observed"
DATA_MODE=demo

# Optional custom path override for the repository data/ directory
# DATA_DIR=./data

# Comma-separated frontend origins permitted by FastAPI CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA POWER live endpoint settings (used only by optional GET /api/v1/fields/{id}/now)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=15.0

# Pipeline credentials (M1 offline pipeline only — never required by backend demo/processed serving)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
GEE_PROJECT=

# Dynamic location analysis (POST /api/v1/locations/compare)
# POWER_HISTORY_START_YEAR=2005
# POWER_HISTORY_TTL_HOURS=24          # recent-data refresh interval (history is not refetched)
# POWER_HISTORY_TIMEOUT_SECONDS=60
# POWER_CACHE_DIR=data/cache/power
# LOCATION_RATE_LIMIT_PER_MINUTE=10
# LOCATION_DATA_CACHE_DIR=data/cache/location
# LOCATION_PROVIDER_TIMEOUT_SECONDS=20
