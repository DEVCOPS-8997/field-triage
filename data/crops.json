{"crop_id": "soybean", "name": "Soybean", "type": "legume", "pest_family": "fabaceae", "growing_days": 110, "heat_threshold_c": 34, "max_heat_days_tolerated": 20, "frost_sensitive": true, "water_need_mm": 500, "drought_tolerance": 2, "waterlogging_tolerance": 2, "root_depth_cm": 120, "n_fix_kg_ha": 0, "residue_cover": "med", "calendars": {"us_midwest": {"sow_month": 5, "harvest_month": 10, "stage_fractions": [0.148, 0.222, 0.444, 0.185]}}, "references": ["FAO-56 Allen et al. 1998", "FAO EcoCrop", "FAO GAEZ v4", "FAO-56 Tables 11-12 (Kc, stage lengths)"], "kc": [0.4, 1.15, 0.5], "n_fix_range_kg_ha": null, "n_fix_note": "Soybean takes a lot of nitrogen from the air, but at good yields the harvested beans carry away about as much, so the net amount left for the next crop is close to zero (Iowa State University). It is counted as 0 kg/ha here.", "n_fix_sources": [{"label": "Iowa State University, Integrated Crop Management: soybean nitrogen balance", "url": "https://www.agronext.iastate.edu/soilfertility/info/Castellano%20ICM%20Formatted.pdf"}, {"label": "Iowa Soybean Association research: soybeans fix about half the N they need", "url": "https://soybeanresearchinfo.com/?p=15097"}]},
